{
  "manifest_version": 3,
  "name": "Total Tab",
  "version": "0.1.0",
  "description": "A calm, customizable new-tab hub: color-coded bookmark folders + widgets.",
  "minimum_chrome_version": "108",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Total Tab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "permissions": [
    "favicon",
    "storage"
  ]
}
